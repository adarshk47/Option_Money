# ── Angel One SmartAPI credentials ─────────────────────────────
# Get these from https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# ── Trading mode ────────────────────────────────────────────────
# PAPER = simulated orders (safe, default) | LIVE = real money
TRADING_MODE=PAPER

# ── Risk settings ───────────────────────────────────────────────
MAX_CAPITAL_PER_TRADE=10000
MAX_TRADES_PER_DAY=10
MAX_DAILY_LOSS=5000
DEFAULT_SL_PERCENT=20
DEFAULT_TARGET1_PERCENT=25
DEFAULT_TARGET2_PERCENT=50

# ── Telegram alerts (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///database/trading.db
# DATABASE_URL=postgresql://user:pass@host:5432/trading

# ── API server (for the Android app) ────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_to_a_long_random_string

# ── Misc ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
VOICE_ALERTS=true
REFRESH_SECONDS=5
